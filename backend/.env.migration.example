# ─────────────────────────────────────────────────────────────────────────────
# ONEREAL LMS — Migration Credentials Template
# Copy this to backend/.env.migration and fill in your values.
# NEVER commit .env.migration to git.
# NEVER paste these values into chat.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Render PostgreSQL (READ-ONLY source — DO NOT modify) ────────────────────
# Full connection string from Render Dashboard > Database > Connection String
# Format: postgresql://user:password@host:port/dbname
RENDER_DATABASE_URL="postgresql://RENDER_USER:RENDER_PASSWORD@RENDER_HOST:5432/onereal_lms"

# ─── Supabase STAGING Project ────────────────────────────────────────────────
# Use a separate test/staging Supabase project — NOT the production project
SUPABASE_STAGING_URL="https://YOUR-STAGING-PROJECT.supabase.co"
SUPABASE_STAGING_ANON_KEY="YOUR-STAGING-ANON-KEY"
SUPABASE_STAGING_SERVICE_ROLE_KEY="YOUR-STAGING-SERVICE-ROLE-KEY"

# Direct PostgreSQL connection to Supabase staging (Port 5432 for migrations/restore)
# Found in Supabase Dashboard > Settings > Database > Connection String (URI)
SUPABASE_STAGING_DATABASE_URL="postgresql://postgres:YOUR-STAGING-DB-PASSWORD@db.YOUR-STAGING-PROJECT.supabase.co:5432/postgres"

# ─── Local backup output path ────────────────────────────────────────────────
# Where pg_dump output file will be saved locally
BACKUP_OUTPUT_PATH="./migration_backups/render_onereal_lms_backup.dump"
