# Copy this file to .env and fill in your own values
# cp .env.example .env

# SQLite database path (no changes needed for local dev)
DATABASE_URL="file:./dev.db"

# Port the backend server will run on
PORT=5000

# JWT Secret - change this to a strong random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_your_strong_secret_key"

# JWT token expiry duration
JWT_EXPIRES_IN="7d"

# Environment: development | production
NODE_ENV="development"

# Password required to enable/disable Maintenance Mode in Settings
MAINTENANCE_PASSWORD="replace_with_your_maintenance_password"
